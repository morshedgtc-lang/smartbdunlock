RewriteEngine On

# Route API requests to PHP
RewriteRule ^api/auth/login$ php/api/auth/login.php [L]
RewriteRule ^api/auth/session$ php/api/auth/session.php [L]
RewriteRule ^api/auth/logout$ php/api/auth/logout.php [L]
RewriteRule ^api/wallet$ php/api/wallet.php [L]
RewriteRule ^api/orders$ php/api/orders.php [L]
RewriteRule ^api/users$ php/api/users.php [L]
RewriteRule ^api/services$ php/api/services.php [L]
RewriteRule ^api/suppliers$ php/api/suppliers.php [L]
RewriteRule ^api/dashboard$ php/api/dashboard.php [L]
RewriteRule ^api/service-categories$ php/api/service-categories.php [L]

# Serve static files
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Fallback to index.html for SPA routing
RewriteRule ^ index.html [L]
