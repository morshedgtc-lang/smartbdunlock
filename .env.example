# ─── Database ──────────────────────────────────────────
# PostgreSQL connection string (Railway internal or external proxy)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ─── Authentication ────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET="your-jwt-secret-here"

# ─── Email Verification (Gmail SMTP) ──────────────────
# Gmail address used to send OTP verification emails
GMAIL_USER="your-email@gmail.com"
# Gmail App Password (not your regular password)
GMAIL_APP_PASSWORD="your-app-password"
# Email address that receives admin notifications (new registrations, etc.)
ADMIN_EMAIL="admin@smartbdunlock.com"

# ─── Supplier API Key Encryption ──────────────────────
# 32 bytes (64 hex characters) for AES-256-GCM
# Generate with: openssl rand -hex 32
SUPPLIER_ENCRYPTION_KEY="your-32-byte-encryption-key"

# ─── Cron Job Authentication ──────────────────────────
# Bearer token for the /api/cron/sync endpoint
CRON_SECRET="your-cron-secret"

# ─── Image Upload (imgbb fallback) ────────────────────
IMGBB_API_KEY="your-imgbb-api-key"

# ─── App URL ───────────────────────────────────────────
# Used for setting cookies and redirect URLs
NEXT_PUBLIC_APP_URL="https://www.smartbdunlock.com"
